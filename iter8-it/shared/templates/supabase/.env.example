# Supabase. Locally: written to .env.local from `npx supabase status` (see
# CLAUDE.md). Production: set by the Supabase <-> Vercel integration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses Row Level Security; never use it in browser code.
SUPABASE_SECRET_KEY=
